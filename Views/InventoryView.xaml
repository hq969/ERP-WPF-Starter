<UserControl x:Class="ERP.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="📋 Inventory Management" 
                   Style="{StaticResource SectionHeaderStyle}"
                   Margin="0,0,0,20"/>

        <!-- Add Product Form -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="280" Margin="0,0,15,0" 
                             Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialTextBoxStyle}"
                             VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewProductName, RelativeSource={RelativeSource Self}}" Value="">
                                        <Setter Property="ToolTip" Value="Enter product name"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    
                    <TextBox Width="120" Margin="0,0,15,0"
                             Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialTextBoxStyle}"
                             VerticalContentAlignment="Center"/>
                    
                    <TextBox Width="140" Margin="0,0,20,0"
                             Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialNumberTextBoxStyle}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="1" Content="➕ Add Product" 
                        Command="{Binding AddProductCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid>
        </Border>

        <!-- Products Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,25,25,15">
                    <TextBlock Text="{Binding ProductCount, StringFormat='📊 Total Products: {0}'}" 
                               Style="{StaticResource SubtitleStyle}" Margin="0,0,30,0"/>
                    <TextBlock Text="{Binding TotalQuantity, StringFormat='📦 Total Items: {0:N0}'}" 
                               Style="{StaticResource SubtitleStyle}"/>
                </StackPanel>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" 
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single"
                          Style="{StaticResource ModernDataGridStyle}"
                          Margin="0,0,0,25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding Price, StringFormat='{}{0:C2}'}" Width="140"/>
                        <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValue, StringFormat='{}{0:C2}'}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary Footer -->
        <Border Grid.Row="4" Style="{StaticResource SummaryCardStyle}" HorizontalAlignment="Right" Margin="0,20,30,30">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TotalInventoryValue, StringFormat='💰 Total Inventory Value: {0:C2}'}" 
                           Style="{StaticResource SummaryValueStyle}" Margin="0,0,25,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
