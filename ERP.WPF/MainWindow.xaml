<Window x:Class="ERP.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ERP.WPF.Views"
        Title="ERP Inventory Management" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="600">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}">
            <TextBlock Text="📦 ERP Inventory System" 
                       Foreground="White"
                       FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="30,0"/>
        </Border>
        
        <!-- Content -->
        <views:InventoryView Grid.Row="1" DataContext="{Binding InventoryView}"/>
    </Grid>
</Window>
